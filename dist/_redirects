# Cloudflare Pages redirects
# Rewrite URL senza estensione a .html preservando query parameters
# IMPORTANTE: NO redirect su pagamento per evitare loop

# FIRMA CONTRATTO - Solo base path, query params passano through
/firma-contratto /firma-contratto.html 200

# CONTRACT SIGNATURE (alias)
/contract-signature /contract-signature.html 200

# CONFIGURAZIONE - Alias verso form-configurazione.html (pagina corretta)
# NOTA: CF Pages serve /form-configurazione natively come pretty URL da form-configurazione.html
# Il rewrite 200 qui fa sì che /configurazione venga servito come se fosse form-configurazione.html
/configurazione /form-configurazione.html 200

# FORM CONFIGURAZIONE - NON serve regola: CF Pages già gestisce pretty URL automaticamente
# (rimuovere la regola evita il loop 308)


# PAGAMENTO - RIMOSSO REDIRECT (servire direttamente .html)
# /pagamento /pagamento.html 200  ← COMMENTATO per evitare loop

# NOTA: pagamento.html viene servito direttamente come file statico
# URL: /pagamento.html?proformaId=XXX (con .html esplicito)
