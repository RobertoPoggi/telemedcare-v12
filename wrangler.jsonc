{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2025-10-06",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  
  // Browser Rendering binding for PDF generation
  "browser": {
    "binding": "BROWSER"
  },
  
  // Force rebuild timestamp: 2026-03-06 21:06
  // Environment: Development (local)
  // NOTE: Cron triggers per Cloudflare Pages NON si configurano qui.
  // Vanno impostati via Cloudflare Dashboard → telemedcare-v12 → Settings → Functions → Cron Triggers
  // oppure via API (vedi script setup-cron.sh).
  // Trigger configurati: "0 6 * * *", "0 10 * * *", "0 18 * * *"
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telemedcare-leads",
      "database_id": "ef89ed07-bf97-47f1-8f4c-c5049b102e57"
    }
  ],

  // Environment configurations per deployment
  "env": {
    "preview": {
      "name": "telemedcare-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "telemedcare-leads-preview",
          "database_id": "128fb147-b114-42d9-8c4d-500d70b8cb43"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "DEBUG_MODE": "true"
      }
    },
    
    "production": {
      "name": "telemedcare-production",
      "d1_databases": [
        {
          "binding": "DB", 
          "database_name": "telemedcare-leads",
          "database_id": "ef89ed07-bf97-47f1-8f4c-c5049b102e57"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "DEBUG_MODE": "false"
      }
    }
  }
}